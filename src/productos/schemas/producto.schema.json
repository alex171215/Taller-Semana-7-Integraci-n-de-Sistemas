{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Producto",
  "type": "object",
  "required": [
    "nombre",
    "precio"
  ],
  "properties": {
    "nombre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "precio": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}